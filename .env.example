# Obbligatorie in build di produzione (fail-closed in src/supabase.js).
# Dev locale: valori in `.env.development`. CI/Ocean li impostano esplicitamente.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry opzionale. Deve essere esplicitamente abilitato.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# OpenTelemetry opzionale. Deve essere esplicitamente abilitato.
# L'endpoint deve essere same-origin, oppure il suo origin va elencato in
# VITE_OTEL_CONNECT_ORIGINS *e* aggiunto a connect-src in vercel.json + ocean/nginx.conf.
VITE_OTEL_ENABLED=false
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
VITE_OTEL_CONNECT_ORIGINS=

# Solo server Vercel: deve coincidere con WHATSAPP_INBOUND_SHARED_SECRET
# configurato nella funzione Supabase randai-whatsapp-inbound.
WHATSAPP_INBOUND_SHARED_SECRET=
# Opzionale: override upstream Edge e URL pubblico usato per la firma Twilio.
RANDAI_WHATSAPP_INBOUND_URL=
WHATSAPP_PUBLIC_WEBHOOK_URL=

# Solo server Vercel: endpoint MCP. I client non-browser normalmente non inviano
# Origin; eventuali origin browser devono essere elencati esplicitamente.
SUPABASE_URL=
SUPABASE_ANON_KEY=
MCP_ALLOWED_ORIGINS=

# Telegram backup parallelo (server-only / Supabase Edge Function telegram-backup).
# Non usare prefisso VITE_: il token non deve arrivare al browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BACKUP_CHAT_ID=
TELEGRAM_TOPIC_HG_SEGNALAZIONI=
TELEGRAM_TOPIC_HC_SEGNALAZIONI=
TELEGRAM_TOPIC_HB_SEGNALAZIONI=
TELEGRAM_TOPIC_HG_INTERVENTI=
TELEGRAM_TOPIC_HC_INTERVENTI=
TELEGRAM_TOPIC_HB_INTERVENTI=
