# Supabase override opzionale. Senza override RandApp usa il progetto pubblicabile configurato in src/supabase.js.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry opzionale. Deve essere esplicitamente abilitato.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# OpenTelemetry opzionale. Deve essere esplicitamente abilitato.
VITE_OTEL_ENABLED=false
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
