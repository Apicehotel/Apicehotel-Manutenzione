{
  "name": "randapp-manutenzione",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:matrix": "node scripts/check-quality-matrix.mjs",
    "test:critical": "node scripts/run-critical-tests.mjs",
    "test:multihotel": "node --test test/multihotel-parity.test.js",
    "test:production": "node --test test/randai-block12-production-43-46.test.js test/randai-block12bis-production-47-50.test.js",
    "test:benchmark": "node --test test/randai-benchmark.test.js",
    "test:e2e": "node test/e2e.mjs",
    "test:device": "node test/device-acceptance.mjs",
    "test:quality": "npm run test:matrix && npm run test:critical && npm run test:multihotel && npm run test:production && npm test",
    "test:autonomy": "node --test test/randai-autonomy-decision.test.js",
    "test:recovery": "node --test test/randai-recovery-engine.test.js",
    "test:software": "node --test test/randai-software-readiness.test.js",
    "test:learning": "node --test test/randai-learning-governance.test.js",
    "test:discovery": "node --test test/randai-discovery-governance.test.js",
    "test:supervisor": "node --test test/randai-supervisor-governance.test.js",
    "test:proactive": "node --test test/randai-proactive-governance.test.js",
    "test:control-center": "node --test test/randai-control-center-governance.test.js",
    "test:ecosystem": "node --test test/randai-block13-ecosystem-51-54.test.js",
    "test:repo-radar": "node --test test/randai-block14-repo-radar-55-58.test.js",
    "repo:radar": "node scripts/repo-radar-snapshot.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-trace-web": "2.10.0",
    "@sentry/react": "10.71.0",
    "@supabase/supabase-js": "^2.57.0",
    "@tanstack/react-query": "^5.102.5",
    "dexie": "^4.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.62.1",
    "vite": "^7.1.0"
  }
}
