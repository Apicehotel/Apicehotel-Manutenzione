    "@opentelemetry/sdk-trace-web": "2.10.0",
    "@sentry/react": "10.71.0",
    "@supabase/supabase-js": "^2.57.0",
    "@tanstack/react-query": "^5.102.5",
    "dexie": "^4.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
