# Ocean preview: nginx serves dist with real 404 for missing hashed assets.
# SPA fallback (index.html) applies only to document navigation, never /assets/*.
FROM node:24-bookworm AS build
WORKDIR /app
# Explicit publishable MultiHotel credentials (no silent fallback in src/supabase.js).
ARG VITE_SUPABASE_URL=https://ooqlfldcrnkudhgjnied.supabase.co
ARG VITE_SUPABASE_ANON_KEY=sb_publishable_Oiu7IOhuUd6YPEDmmSa7zA_ngNuiSlX
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
COPY package.json package-lock.json .nvmrc ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY ocean/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/manifest.webmanifest >/dev/null || exit 1
