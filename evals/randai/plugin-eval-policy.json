{
  "version": "1.0.0",
  "owner": "RandAI/QualityMatrix",
  "engine": "Promptfoo",
  "sourcePattern": "openai/plugins:plugin-eval",
  "mode": "ADAPT_PATTERN",
  "requiredDimensions": [
    "security",
    "hotelIsolation",
    "permissions",
    "correctness",
    "regression",
    "cost",
    "maintainability",
    "rollback"
  ],
  "promotion": {
    "requireAllCriticalPass": true,
    "requireHumanReview": true,
    "allowAutomaticProductionPromotion": false,
    "maxCriticalFindings": 0
  },
  "evidence": [
    "evals/randai/promptfooconfig.yaml",
    "test/quality-matrix.json",
    ".github/workflows/randai-group1-security.yml"
  ],
  "fixFirstOrder": [
    "security",
    "hotelIsolation",
    "permissions",
    "correctness",
    "regression",
    "rollback",
    "cost",
    "maintainability"
  ]
}
